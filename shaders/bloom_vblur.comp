#version 450

// Horizontal Gaussian blur pass for bloom
// Separable blur: horizontal pass first, then vertical pass

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D inputTexture;
layout(set = 0, binding = 1) uniform writeonly image2D outputTexture;

layout(set = 1, binding = 0) uniform BlurUniforms {
    vec2 inputResolution;
    vec2 outputResolution;
    vec2 texelSize;
    float blurRadius;        // Distance between samples in texels
    int blurSamples;         // Number of samples on each side (total = 2*blurSamples + 1)
};

// Gaussian weight function
float Gaussian(float x, float sigma) {
    return exp(-(x * x) / (2.0 * sigma * sigma));
}

void main() {
    vec2 texCoord = gl_GlobalInvocationID.xy * texelSize;

    if (gl_GlobalInvocationID.x >= uint(outputResolution.x) ||
        gl_GlobalInvocationID.y >= uint(outputResolution.y)) {
        return;
    }

    float totalWeight = 0.0;
    vec3 colorSum = vec3(0.0);

    // Determine sigma from blurRadius if not explicitly provided
    float sigma = blurRadius > 0.0 ? blurRadius / 2.0 : 1.0;

    int samples = blurSamples > 0 ? blurSamples : 9;

    // Sample horizontal line with Gaussian weights
    for (int i = -9; i <= 9; i++) {
        if (i >= -samples && i <= samples) {
            float offset = float(i) * blurRadius;
            float weight = Gaussian(offset, sigma);

            vec2 offsetTexCoord = texCoord + vec2(offset, 0.0);
            vec3 sampleColor = texture(inputTexture, offsetTexCoord).rgb;

            colorSum += sampleColor * weight;
            totalWeight += weight;
        }
    }

    vec3 blurred = colorSum / totalWeight;
    imageStore(outputTexture, ivec2(gl_GlobalInvocationID.xy), vec4(blurred, 1.0));
}