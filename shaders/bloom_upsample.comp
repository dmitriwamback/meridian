#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D srcTexture;
layout(set = 0, binding = 1, rgba16f) uniform image2D dstImage;

layout(std140, set = 1, binding = 0) uniform BloomUniforms {
    vec2 inputResolution;
    vec2 outputResolution;
    vec2 inputTexelSize;

    vec2 srcResolution;
    vec2 srcTexelSize;

    float threshold;
    float softKnee;
    float filterRadius;
    float padding;
};

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(outputResolution.x) || coord.y >= int(outputResolution.y)) return;

    vec2 uv = (vec2(coord) + vec2(0.5)) / outputResolution;
    vec2 r  = inputTexelSize * filterRadius;

    vec3 a = texture(srcTexture, uv + vec2(-r.x,  r.y)).rgb;
    vec3 b = texture(srcTexture, uv + vec2( 0.0,  r.y)).rgb;
    vec3 c = texture(srcTexture, uv + vec2( r.x,  r.y)).rgb;
    vec3 d = texture(srcTexture, uv + vec2(-r.x,  0.0)).rgb;
    vec3 e = texture(srcTexture, uv                   ).rgb;
    vec3 f = texture(srcTexture, uv + vec2( r.x,  0.0)).rgb;
    vec3 g = texture(srcTexture, uv + vec2(-r.x, -r.y)).rgb;
    vec3 h = texture(srcTexture, uv + vec2( 0.0, -r.y)).rgb;
    vec3 i = texture(srcTexture, uv + vec2( r.x, -r.y)).rgb;

    vec3 upsample = e * 4.0;
    upsample += (b + d + f + h) * 2.0;
    upsample += (a + c + g + i);
    upsample *= 1.0 / 16.0;

    // Read existing destination value and accumulate
    vec3 existing = imageLoad(dstImage, coord).rgb;
    imageStore(dstImage, coord, vec4(existing + upsample, 1.0));
}